# ============================================================
# RANDEVALL — PRODUCTION ORTAM SABLONU
# Sunucuda bu dosyayi `.env` olarak kopyalayin ve DEGERLERI DOLDURUN.
# `php artisan key:generate` ile APP_KEY uretin.
# Yayindan once: php artisan config:cache route:cache view:cache
# ============================================================

APP_NAME=Randevall
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Gercek domaininiz (https zorunlu — odeme callback ve e-posta linkleri buna gore uretilir)
APP_URL=https://randevall.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

APP_MAINTENANCE_DRIVER=file

# Prod'da bcrypt maliyeti
BCRYPT_ROUNDS=12

# Loglar: prod'da yalnizca hata seviyesinde, gunluk dosya rotasyonu
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Veritabani (uretim MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=randevall
DB_USERNAME=randevall
DB_PASSWORD=DEGISTIRIN_guclu_bir_parola

# --- Oturum (prod: guvenli cerezler) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Kuyruk: WhatsApp/e-posta arka planda islenir ---
# Bir queue worker (supervisor) veya schedule:run cron'u SART.
QUEUE_CONNECTION=database

# --- Onbellek ---
CACHE_STORE=database

# --- Yasal / marka ---
LEGAL_EMAIL=bilgi@randevall.com
LEGAL_TRIAL_DAYS=0

# ============================================================
# E-POSTA — GERCEK SMTP/SAGLAYICI SART (varsayilan "log" MAIL GONDERMEZ)
# Ornek: Resend / Postmark / SES / kurumsal SMTP
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=DEGISTIRIN
MAIL_PASSWORD=DEGISTIRIN
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="bilgi@randevall.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alternatif — Resend (MAIL_MAILER=resend yapip anahtari girin):
# RESEND_API_KEY=

# ============================================================
# NOT: WhatsApp (Meta/Twilio) ve PayTR kimlik bilgileri
# .env'den DEGIL, Super Admin > Ayarlar ekranindan (system_settings)
# girilir. Sifrelenerek saklanir.
# ============================================================
